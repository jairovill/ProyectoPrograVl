@model ProyectoPrograVI.Models.MetodoPago
@{
    ViewData["Title"] = "Editar Método de Pago";
}

<div class="content-area">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0"><i class="fas fa-edit me-2"></i>@ViewData["Title"]</h4>
                <a asp-action="Index" class="btn btn-sm btn-outline-marron">
                    <i class="fas fa-arrow-left me-1"></i> Volver
                </a>
            </div>
        </div>
        <div class="card-body">
            <form asp-action="Edit" class="needs-validation" novalidate>
                <input type="hidden" asp-for="MetodoPagoId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="form-label fw-bold">Tipo de Método</label>
                            <input type="text" class="form-control-plaintext" readonly
                                   value="@ObtenerNombreMostrable(Model.Nombre)" />
                            <input type="hidden" asp-for="Nombre" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Activo" class="form-label fw-bold">Estado</label>
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" asp-for="Activo"
                                       style="width: 3em; height: 1.5em;">
                                <label class="form-check-label ms-2">Activo</label>
                            </div>
                            <span asp-validation-for="Activo" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-marron px-4">
                        <i class="fas fa-times me-2"></i> Cancelar
                    </a>
                    <button type="submit" class="btn btn-marron px-4">
                        <i class="fas fa-save me-2"></i> Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@functions {
    public string ObtenerNombreMostrable(string nombreInterno)
    {
        switch (nombreInterno)
        {
            case "transferencia":
                return "Transferencia Bancaria";
            case "PayPal":
                return "PayPal";
            case "tarjeta":
                return "Tarjeta de Crédito/Débito";
            default:
                return nombreInterno;
        }
    }
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}