@model ProyectoPrograVI.Models.MetodoPago
@{
    ViewData["Title"] = "Nuevo Método de Pago";
}

<div class="content-area">
    <div class="card shadow">
        <div class="card-header bg-marron-claro text-light">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="mb-0"><i class="fas fa-credit-card me-2"></i>@ViewData["Title"]</h2>
                <a asp-action="Index" class="btn btn-outline-light btn-sm">
                    <i class="fas fa-arrow-left me-1"></i> Volver
                </a>
            </div>
        </div>
        <div class="card-body">
            <form asp-action="Create" class="needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Nombre" class="form-label">Método de Pago*</label>
                            <select asp-for="Nombre" class="form-select" required>
                                <option value="">-- Seleccione un método --</option>
                                @foreach (var tipo in (IEnumerable<ProyectoPrograVI.Models.MetodoPago.TiposMetodoPago>)ViewBag.TiposMetodoPago)
                                {
                                    <option value="@tipo.ToString()">@ObtenerNombreMostrable(tipo.ToString())</option>
                                }
                            </select>
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                            <div class="invalid-feedback">
                                Por favor seleccione un método de pago
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Activo" class="form-label">Estado</label>
                            <div class="form-switch mt-2">
                                <input class="form-check-input" type="checkbox" asp-for="Activo" checked>
                                <label class="form-check-label" for="Activo">Activo</label>
                            </div>
                            <span asp-validation-for="Activo" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <button type="submit" class="btn btn-marron">
                        <i class="fas fa-save me-1"></i> Guardar
                    </button>
                    <a asp-action="Index" class="btn btn-outline-marron">
                        <i class="fas fa-times me-1"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@functions {
    public string ObtenerNombreMostrable(string nombreInterno)
    {
        switch (nombreInterno)
        {
            case "transferencia":
                return "Transferencia Bancaria";
            case "PayPal":
                return "PayPal";
            case "tarjeta":
                return "Tarjeta de Crédito/Débito";
            default:
                return nombreInterno;
        }
    }
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Validación del lado del cliente
        (function () {
            'use strict'

            var forms = document.querySelectorAll('.needs-validation')

            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }

                        form.classList.add('was-validated')
                    }, false)
                })
        })()
    </script>
}