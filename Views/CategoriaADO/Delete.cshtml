@model ProyectoPrograVI.Models.Categoria

<h1>Eliminar Categoría</h1>

<h4>¿Estás seguro que deseas eliminar esta categoría?</h4>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.categoria_id</dd>

        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.nombre</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="categoria_id" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
