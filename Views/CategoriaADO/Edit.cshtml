@model ProyectoPrograVI.Models.Categoria

<div class="content-area">
    <div class="card shadow-sm border-0" style="max-width: 600px; margin: 0 auto;">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Editar Categoría</h3>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post" class="needs-validation" novalidate>
                <input type="hidden" asp-for="categoria_id" />

                <div class="mb-4">
                    <label asp-for="nombre" class="form-label fw-bold">Nombre de la Categoría</label>
                    <input asp-for="nombre" class="form-control form-control-lg" />
                    <span asp-validation-for="nombre" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <button type="submit" class="btn btn-marron px-4">
                        <i class="fas fa-save me-2"></i>Actualizar
                    </button>
                    <a class="btn btn-outline-marron px-4" asp-controller="CategoriaADO" asp-action="Index">
                        <i class="fas fa-arrow-left me-2"></i>Regresar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}