@model IEnumerable<ProyectoPrograVI.Models.Categoria>

@{
    ViewData["Title"] = "Listado de Categorías";
}

<div class="content-area">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-tags me-2"></i>@ViewData["Title"]</h1>
        <a asp-action="Index" asp-controller="Home" class="btn btn-outline-regresar">
            <i class="bi bi-arrow-left"></i> Regresar
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-marron-claro text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-sliders me-2"></i>Opciones de Categorías</h5>
                <div>
                    <a asp-action="Create" class="btn btn-sm btn-marron me-2">
                        <i class="bi bi-plus-circle"></i> Nueva
                    </a>
                    <a asp-action="ExportarCSV" class="btn btn-sm btn-outline-light">
                        <i class="bi bi-file-earmark-excel"></i> Exportar
                    </a>
                </div>
            </div>
        </div>
        <div class="card-body">
            <form asp-action="ExportarCSVFiltrado" method="get" class="row g-3 align-items-center">
                <div class="col-md-8">
                    <label for="filtroNombre" class="form-label">Filtrar por nombre:</label>
                    <div class="input-group">
                        <input type="text" name="filtroNombre" id="filtroNombre" class="form-control"
                               placeholder="Buscar categorías...">
                        <button type="submit" class="btn btn-marron">
                            <i class="bi bi-filter-circle"></i> Exportar Filtrado
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="tablaCategorias" class="table table-marron table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th style="width: 140px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var categoria in Model)
                        {
                            <tr>
                                <td>@categoria.categoria_id</td>
                                <td>@categoria.nombre</td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@categoria.categoria_id"
                                           class="btn btn-outline-marron" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@categoria.categoria_id"
                                           class="btn btn-outline-danger" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
    <!-- Iconos de Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <script>
        $(document).ready(function () {
            $('#tablaCategorias').DataTable({
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json"
                },
                dom: '<"top"<"d-flex justify-content-between align-items-center"lf><"d-flex justify-content-end"B>>rt<"bottom"ip>',
                buttons: [
                    {
                        extend: 'excel',
                        text: '<i class="bi bi-file-earmark-excel"></i> Exportar Excel',
                        className: 'btn btn-outline-success btn-sm'
                    }
                ],
                columnDefs: [
                    { orderable: false, targets: 2 } // Deshabilitar ordenación en columna de acciones
                ],
                initComplete: function () {
                    $('.dataTables_filter input').addClass('form-control form-control-sm');
                    $('.dataTables_length select').addClass('form-control form-control-sm');
                }
            });
        });
    </script>
}