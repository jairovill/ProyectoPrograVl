@model ProyectoPrograVI.Models.Usuario
@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="content-area">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="fas fa-user-edit me-2"></i>Editar Usuario</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post" class="needs-validation" novalidate>
                <input type="hidden" asp-for="usuario_id" />
                <input type="hidden" asp-for="persona_id" />

                <div class="row">
                    <!-- Columna Izquierda - Datos Personales -->
                    <div class="col-md-6">
                        <div class="bg-marron-claro p-3 rounded mb-4">
                            <h5 class="text-white mb-0"><i class="fas fa-user me-2"></i>Datos Personales</h5>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="identificacion" class="form-label fw-bold">Identificación</label>
                            <input asp-for="identificacion" class="form-control" style="text-transform:uppercase" />
                            <span asp-validation-for="identificacion" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="nombre" class="form-label fw-bold">Nombre</label>
                            <input asp-for="nombre" class="form-control" />
                            <span asp-validation-for="nombre" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="apellido1" class="form-label fw-bold">Primer Apellido</label>
                            <input asp-for="apellido1" class="form-control" />
                            <span asp-validation-for="apellido1" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="apellido2" class="form-label">Segundo Apellido</label>
                            <input asp-for="apellido2" class="form-control" />
                            <span asp-validation-for="apellido2" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="fecha_nacimiento" class="form-label">Fecha de Nacimiento</label>
                            <input asp-for="fecha_nacimiento" type="date" class="form-control" />
                            <span asp-validation-for="fecha_nacimiento" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Columna Derecha - Datos de Usuario -->
                    <div class="col-md-6">
                        <div class="bg-marron-claro p-3 rounded mb-4">
                            <h5 class="text-white mb-0"><i class="fas fa-user-cog me-2"></i>Datos de Cuenta</h5>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="email" class="form-label fw-bold">Email</label>
                            <input asp-for="email" type="email" class="form-control" />
                            <span asp-validation-for="email" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="contrasena" class="form-label">Contraseña</label>
                            <div class="input-group">
                                <input asp-for="contrasena" type="password" class="form-control" />
                                <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="contrasena" class="text-danger small"></span>
                            <small class="form-text text-muted">Dejar en blanco para mantener la contraseña actual</small>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="rol_id" class="form-label fw-bold">Rol</label>
                            <select asp-for="rol_id" asp-items="Model.Roles" class="form-select">
                                <option value="">Seleccione un rol</option>
                            </select>
                            <span asp-validation-for="rol_id" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="documento_identidad_id" class="form-label fw-bold">Tipo de Documento</label>
                            <select asp-for="documento_identidad_id" asp-items="Model.DocumentosIdentidad" class="form-select">
                                <option value="">Seleccione un documento</option>
                            </select>
                            <span asp-validation-for="documento_identidad_id" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="estado" class="form-label fw-bold">Estado</label>
                            <select asp-for="estado" asp-items="Model.Estados" class="form-select">
                                <option value="">Seleccione un estado</option>
                            </select>
                            <span asp-validation-for="estado" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-marron px-4">
                        <i class="fas fa-arrow-left me-2"></i>Regresar
                    </a>
                    <button type="submit" class="btn btn-marron px-4">
                        <i class="fas fa-save me-2"></i>Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
            // Ocultar/mostrar contraseña
            $('#togglePassword').click(function() {
                const input = $('#contrasena');
                const icon = $(this).find('i');

                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.removeClass('fa-eye').addClass('fa-eye-slash');
                } else {
                    input.attr('type', 'password');
                    icon.removeClass('fa-eye-slash').addClass('fa-eye');
                }
            });

            // Manejo de contraseña
            $('#contrasena').val(''); // Limpiar campo al cargar
            $('form').submit(function() {
                if ($('#contrasena').val() === '') {
                    $('#contrasena').val('no-change');
                }
            });

            // Mostrar mensajes de TempData
        @if (TempData["Mensaje"] != null)
        {
            <text>
                    Swal.fire({
                        icon: 'success',
                        title: 'Éxito',
                        text: '@Html.Raw(TempData["Mensaje"])',
                        confirmButtonColor: '#6c757d'
                    });
            </text>
        }

            // Mostrar errores de validación
        @if (!ViewData.ModelState.IsValid)
        {
            <text>
                    var errorMessages = '';
                @foreach (var item in ViewData.ModelState.Values)
                {
                    foreach (var error in item.Errors)
                    {
                        <text>errorMessages += '@Html.Raw(error.ErrorMessage.Replace("'", "\\'"))' + '<br/>';</text>
                    }
                }
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        html: errorMessages,
                        confirmButtonColor: '#6c757d'
                    });
            </text>
        }
        });
    </script>
}