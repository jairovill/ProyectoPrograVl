@model IEnumerable<ProyectoPrograVI.Models.Usuario>

@{
    ViewData["Title"] = "Listado de Usuarios";
}

<div class="content-area">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-people me-2"></i>@ViewData["Title"]</h1>
        <a asp-action="Index" asp-controller="Home" class="btn btn-outline-regresar">
            <i class="bi bi-arrow-left"></i> Regresar
        </a>
    </div>

    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-header bg-marron-claro text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-sliders me-2"></i>Opciones de Usuarios</h5>
                <a asp-action="Create" class="btn btn-sm btn-outline-light">
                    <i class="bi bi-plus-circle"></i> Nuevo
                </a>
            </div>
        </div>
        <div class="card-body">
            <form asp-action="ExportarCSVFiltrado" method="get" class="row g-3 align-items-end">
                <div class="col-md-8">
                    <label for="filtroNombre" class="form-label">Filtrar por nombre:</label>
                    <div class="input-group">
                        <input type="text" name="filtroNombre" id="filtroNombre" class="form-control"
                               placeholder="Buscar usuarios...">
                        <button type="submit" class="btn btn-marron">
                            <i class="bi bi-filter-circle"></i> Exportar Filtrado
                        </button>
                        <a asp-action="ExportarCSV" class="btn btn-outline-marron">
                            <i class="bi bi-file-earmark-text"></i> Exportar CSV
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table id="tablaUsuarios" class="table table-marron mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Identificación</th>
                        <th>Nombre Completo</th>
                        <th>Email</th>
                        <th>Rol</th>
                        <th>Tipo Documento</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in Model)
                    {
                        <tr>
                            <td>@usuario.usuario_id</td>
                            <td>@usuario.identificacion</td>
                            <td>@usuario.nombre @usuario.apellido1 @usuario.apellido2</td>
                            <td>@usuario.email</td>
                            <td>@usuario.rol_nombre</td>
                            <td>@usuario.documento_nombre</td>
                            <td>
                                @if (usuario.estado == "activo")
                                {
                                    <span class="badge bg-success rounded-pill"><i class="bi bi-check-circle me-1"></i>Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger rounded-pill"><i class="bi bi-x-circle me-1"></i>Inactivo</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@usuario.usuario_id" class="btn btn-sm btn-outline-marron" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (usuario.estado == "activo")
                                    {
                                        <form asp-action="ToggleStatus" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@usuario.usuario_id" />
                                            <button type="submit" class="btn btn-sm btn-outline-warning" title="Desactivar">
                                                <i class="bi bi-toggle-on"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="ToggleStatus" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@usuario.usuario_id" />
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Activar">
                                                <i class="bi bi-toggle-off"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
    <!-- Iconos de Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <script>
        $(document).ready(function () {
            $('#tablaUsuarios').DataTable({
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json"
                },
                dom: '<"top"lf>rt<"bottom"ip>',
                columnDefs: [
                    { orderable: false, targets: [7] } // Deshabilitar ordenación en columna de acciones
                ]
            });
        });
    </script>
}