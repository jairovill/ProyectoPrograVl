@model ProyectoPrograVI.Models.CarritoCompra

@{
    ViewData["Title"] = "Finalizar Compra 1";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="row">
        <div class="col-md-8">
            <h4>Resumen de tu pedido</h4>
            <table class="table">
                <thead>
                    <tr>
                        <th>Libro</th>
                        <th>Precio</th>
                        <th>Cantidad</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ViewBag.ItemsCarrito)
                    {
                        <tr>
                            <td>@item.Titulo</td>
                            <td>@item.Precio.ToString("C")</td>
                            <td>@item.Cantidad</td>
                            <td>@((item.Precio * item.Cantidad).ToString("C"))</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="3">Total:</th>
                        <th>@ViewBag.TotalCarrito.ToString("C")</th>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5>Información de Pago</h5>
                </div>
                <div class="card-body">
                    <form asp-action="ProcesarCheckout" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="UsuarioId" />
                        <input type="hidden" asp-for="CarritoId" />

                        <div class="form-group">
                            <label asp-for="Estado" class="control-label"></label>
                            <select asp-for="Estado" asp-items="Model.Estados" class="form-control"></select>
                            <span asp-validation-for="Estado" class="text-danger"></span>
                        </div>

                        <div class="form-group mt-3">
                            <button type="submit" class="btn btn-primary btn-block">Confirmar Compra</button>
                            <a asp-action="Index" class="btn btn-secondary btn-block">Volver al Carrito</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}