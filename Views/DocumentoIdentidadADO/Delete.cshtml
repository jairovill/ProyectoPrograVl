@model ProyectoPrograVI.Models.DocumentoIdentidad

@{
    ViewData["Title"] = "Eliminar Documento Identidad";
}

<h1 class="text-danger">Eliminar Documento</h1>

<h4>¿Estás seguro que deseas eliminar este Documento?</h4>
<hr />

<div class="alert alert-warning">
    <strong>Advertencia:</strong> Esta acción no se puede deshacer.
</div>

<div>
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.documento_identidad_id</dd>

        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.nombre</dd>
    </dl>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="documento_identidad_id" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
