@model ProyectoPrograVI.Models.DocumentoIdentidad

<div class="content-area">
    <div class="card shadow-sm border-0" style="max-width: 600px; margin: 0 auto;">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Editar Documento de Identidad</h3>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post" class="needs-validation" novalidate>
                <input type="hidden" asp-for="documento_identidad_id" />

                <div class="mb-4">
                    <label asp-for="nombre" class="form-label fw-bold">Tipo de Documento</label>
                    <input asp-for="nombre" class="form-control form-control-lg" style="text-transform:uppercase" />
                    <span asp-validation-for="nombre" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <button type="submit" class="btn btn-marron px-4">
                        <i class="fas fa-save me-2"></i>Actualizar
                    </button>
                    <a asp-action="Index" class="btn btn-outline-marron px-4">
                        <i class="fas fa-times me-2"></i>Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}