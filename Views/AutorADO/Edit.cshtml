@model ProyectoPrograVI.Models.Autor

<div class="content-area">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Editar Autor</h3>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post" class="needs-validation" novalidate>
                <input type="hidden" asp-for="autor_id" />
                <input type="hidden" asp-for="persona_id" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="identificacion" class="form-label">Identificación</label>
                        <input asp-for="identificacion" class="form-control" style="text-transform:uppercase" />
                        <span asp-validation-for="identificacion" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="nombre" class="form-label">Nombre</label>
                        <input asp-for="nombre" class="form-control" />
                        <span asp-validation-for="nombre" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="apellido1" class="form-label">Primer Apellido</label>
                        <input asp-for="apellido1" class="form-control" />
                        <span asp-validation-for="apellido1" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="apellido2" class="form-label">Segundo Apellido</label>
                        <input asp-for="apellido2" class="form-control" />
                        <span asp-validation-for="apellido2" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="fecha_nacimiento" class="form-label">Fecha Nacimiento</label>
                        <input asp-for="fecha_nacimiento" class="form-control" type="date" />
                        <span asp-validation-for="fecha_nacimiento" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="fecha_defuncion" class="form-label">Fecha Defunción</label>
                        <input asp-for="fecha_defuncion" class="form-control" type="date" />
                        <span asp-validation-for="fecha_defuncion" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <button type="submit" class="btn btn-marron">
                        <i class="fas fa-save me-2"></i>Actualizar
                    </button>
                    <a class="btn btn-outline-marron" asp-controller="AutorADO" asp-action="Index">
                        <i class="fas fa-arrow-left me-2"></i>Regresar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}