@model IEnumerable<ProyectoPrograVI.Models.Autor>

@{
    ViewData["Title"] = "Listado de Autores";
}

<div class="content-area">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Autores</h1>
        <a asp-action="Index" asp-controller="Home" class="btn btn-outline-regresar">
            <i class="bi bi-arrow-left"></i> Regresar
        </a>
    </div>

    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-header bg-primary text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Opciones de Exportación</h5>
                <a asp-action="Create" class="btn btn-sm btn-outline-light">
                    <i class="bi bi-plus-circle"></i> Agregar Nuevo
                </a>
            </div>
        </div>
        <div class="card-body">
            <form asp-action="ExportarCSVFiltrado" method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label for="letraInicial" class="form-label">Filtrar por letra inicial:</label>
                    <input type="text" name="letraInicial" id="letraInicial" class="form-control"
                           placeholder="Ej: A" maxlength="1" style="text-transform:uppercase">
                </div>
                <div class="col-md-4 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-marron">
                        <i class="bi bi-filter-circle"></i> Exportar Filtrado
                    </button>
                    <a asp-action="ExportarCSV" class="btn btn-outline-marron ms-2">
                        <i class="bi bi-file-earmark-excel"></i> Exportar CSV
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table id="tablaAutores" class="table table-marron mb-0">
                <thead>
                    <tr>
                        <th>Identificación</th>
                        <th>Nombre</th>
                        <th>Primer Apellido</th>
                        <th>Segundo Apellido</th>
                        <th>Fecha Nacimiento</th>
                        <th>Fecha Defunción</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var autor in Model)
                    {
                        <tr>
                            <td>@autor.identificacion</td>
                            <td>@autor.nombre</td>
                            <td>@autor.apellido1</td>
                            <td>@autor.apellido2</td>
                            <td>@(autor.fecha_nacimiento?.ToString("yyyy-MM-dd"))</td>
                            <td>@(autor.fecha_defuncion?.ToString("yyyy-MM-dd"))</td>
                            <td class="text-end">
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@autor.autor_id" class="btn btn-sm btn-outline-marron" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@autor.autor_id" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <script>
        $(document).ready(function () {
            $('#tablaAutores').DataTable({
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json"
                },
                dom: '<"top"lf>rt<"bottom"ip>',
                columnDefs: [
                    { orderable: false, targets: 6 }
                ]
            });

            $('#letraInicial').on('input', function() {
                this.value = this.value.toUpperCase();
            });
        });
    </script>
}