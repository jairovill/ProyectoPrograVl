@model List<ProyectoPrograVI.Models.BitacoraMovimiento>
@{
    ViewData["Title"] = "Bitácora de Movimientos";
}
<h2>Bitácora de Movimientos</h2>
<div class="d-flex justify-content-end mb-3">
    <a asp-action="ExportarCSV" class="btn btn-sm btn-outline-success">
        <i class="bi bi-file-earmark-excel"></i> Exportar CSV
    </a>
    <a asp-action="Index" asp-controller="Home" class="btn btn-outline-regresar">
        <i class="bi bi-arrow-left"></i> Regresar
    </a>
</div>

<table id="tablaBitacora" class="table table-striped table-marron">
    <thead>
        <tr>
            <th>ID</th>
            <th>Fecha</th>
            <th>Operación</th>
            <th>Tabla</th>
            <th>ID Registro</th>
            <th>Detalle</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.FechaMovimiento.ToString("dd/MM/yyyy HH:mm:ss")</td>
                <td>@item.TipoOperacion</td>
                <td>@item.NombreTabla</td>
                <td>@item.IdRegistroAfectado</td>
                <td>@item.Detalle</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet" />

    <script>
        $(document).ready(function () {
            $('#tablaBitacora').DataTable({
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json"
                },
                order: [[1, 'desc']]
            });
        });
    </script>
}