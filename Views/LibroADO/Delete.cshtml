@model ProyectoPrograVI.Models.Libro

@{
    ViewData["Title"] = "Eliminar Libro";
}

<div class="card border-danger">
    <div class="card-header bg-danger text-white">
        <h3 class="mb-0">
            <i class="bi bi-exclamation-triangle"></i> Eliminar Libro
        </h3>
    </div>
    <div class="card-body">
        <h5 class="text-danger">¿Está seguro que desea eliminar este libro?</h5>
        <p class="text-muted">Esta acción cambiará el estado del libro a "inactivo" y no aparecerá en el catálogo.</p>

        <hr />

        <div class="row">
            <!-- Información Básica -->
            <div class="col-md-6">
                <h5 class="text-primary">Información Básica</h5>
                <dl class="row">
                    <dt class="col-sm-4">ID</dt>
                    <dd class="col-sm-8">@Model.LibroId</dd>

                    <dt class="col-sm-4">Título</dt>
                    <dd class="col-sm-8">@Model.Titulo</dd>

                    <dt class="col-sm-4">Autor</dt>
                    <dd class="col-sm-8">@Model.AutorNombre</dd>

                    <dt class="col-sm-4">Categoría</dt>
                    <dd class="col-sm-8">@Model.CategoriaNombre</dd>
                </dl>
            </div>

            <!-- Detalles del Libro -->
            <div class="col-md-6">
                <h5 class="text-primary">Detalles</h5>
                <dl class="row">
                    <dt class="col-sm-4">Precio</dt>
                    <dd class="col-sm-8">@Model.Precio.ToString("C")</dd>

                    <dt class="col-sm-4">Disponibles</dt>
                    <dd class="col-sm-8">@Model.UnidadesDisponibles</dd>

                    <dt class="col-sm-4">ISBN</dt>
                    <dd class="col-sm-8">@Model.ISBN</dd>

                    <dt class="col-sm-4">Estado</dt>
                    <dd class="col-sm-8">
                        @if (Model.Estado == "activo")
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactivo</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <!-- Imagen del libro si existe -->
        @if (!string.IsNullOrEmpty(Model.ImagenUrl))
        {
            <div class="row mt-3">
                <div class="col-md-12">
                    <h5 class="text-primary">Portada Actual</h5>
                    <img src="@Model.ImagenUrl" alt="Portada del libro" style="max-height: 200px;" class="img-thumbnail" />
                </div>
            </div>
        }
    </div>
    <div class="card-footer bg-light">
        <form asp-action="ToggleStatus" method="post" class="d-flex justify-content-between">
            <input type="hidden" name="id" value="@Model.LibroId" />

            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Cancelar
            </a>
            <button type="submit" class="btn btn-danger">
                @if (Model.Estado == "activo")
                {
                    <i class="bi bi-toggle-off"></i>
                    <span>Desactivar Libro</span>
                }
                else
                {
                    <i class="bi bi-toggle-on"></i>
                    <span>Activar Libro</span>
                }
            </button>
        </form>
    </div>
</div>

@section Styles {
    <style>
        dt {
            font-weight: 500;
        }

        dd {
            margin-bottom: 0.5rem;
        }

        .img-thumbnail {
            max-width: 300px;
            height: auto;
        }
    </style>
}

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet" />
}