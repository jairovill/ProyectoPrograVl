@model ProyectoPrograVI.Models.Libro

@{
    ViewData["Title"] = "Detalles del Libro";
}

<div class="container py-5">
    <div class="row">
        <!-- Columna de la imagen -->
        <div class="col-md-5">
            <div class="card shadow-sm">
                @if (!string.IsNullOrEmpty(Model.ImagenUrl))
                {
                    <img src="@Model.ImagenUrl" class="card-img-top img-fluid" alt="@Model.Titulo" style="max-height: 500px; object-fit: contain;">
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center bg-light" style="height: 300px;">
                        <i class="bi bi-book text-muted" style="font-size: 5rem;"></i>
                    </div>
                }
                <div class="card-body text-center">
                    <!-- Estado y disponibilidad -->
                    <div class="d-flex justify-content-center gap-2 mb-3">
                        @if (Model.Estado == "activo")
                        {
                            <span class="badge bg-success">Disponible</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">No disponible</span>
                        }

                        @if (Model.UnidadesDisponibles > 0)
                        {
                            <span class="badge bg-primary">@Model.UnidadesDisponibles unidades</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Agotado</span>
                        }
                    </div>

                    <!-- Precio -->
                    <h3 class="text-primary fw-bold">@Model.Precio.ToString("C")</h3>

                    <!-- Botón de añadir al carrito -->
                    @if (Model.UnidadesDisponibles > 0 && Model.Estado == "activo")
                    {


                        <form asp-controller="Carrito" asp-action="AddToCart" method="post" class="mt-3 d-flex align-items-center gap-2">
                            <input type="hidden" name="libroId" value="@Model.LibroId" />
                            <input type="number" name="cantidad" value="1" min="1" />
                            <button type="submit" class="btn btn-primary">Agregar al carrito</button>
                        </form>


                    }
                </div>
            </div>
        </div>

        <!-- Columna de la información -->
        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0">@Model.Titulo</h2>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <h4 class="text-muted">@Model.AutorNombre</h4>
                        <span class="badge bg-info">@Model.CategoriaNombre</span>
                    </div>

                    <hr />

                    <!-- Detalles principales -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h5>ISBN:</h5>
                            <p>@(string.IsNullOrEmpty(Model.ISBN) ? "No disponible" : Model.ISBN)</p>
                        </div>
                        <div class="col-md-6">
                            <h5>Editorial:</h5>
                            <p>@(string.IsNullOrEmpty(Model.Editorial) ? "No disponible" : Model.Editorial)</p>
                        </div>
                    </div>

                    <!-- Descripción completa -->
                    <div class="mb-4">
                        <h5>Descripción:</h5>
                        <p class="text-justify">@(string.IsNullOrEmpty(Model.Descripcion) ? "No hay descripción disponible." : Model.Descripcion)</p>
                    </div>

                    <!-- Información adicional -->
                    <div class="alert alert-info">
                        <h5><i class="bi bi-info-circle"></i> Información adicional</h5>
                        <ul class="mb-0">
                            <li>Envío gratuito para pedidos superiores a $50</li>
                            <li>Devoluciones fáciles dentro de los 30 días</li>
                            <li>Pago seguro con tarjeta o PayPal</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Botón de volver -->
            <div class="mt-3">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Volver al catálogo
                </a>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border-radius: 0.5rem;
            overflow: hidden;
        }

        .card-img-top {
            background-color: #f8f9fa;
            padding: 1rem;
        }

        .badge {
            font-size: 0.9rem;
            padding: 0.5em 0.75em;
        }

        h2, h3, h4, h5 {
            color: #333;
        }

        .text-justify {
            text-align: justify;
        }
    </style>
}

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet" />
}