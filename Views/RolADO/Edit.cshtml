@model ProyectoPrograVI.Models.Rol
@{
    ViewData["Title"] = "Editar Rol";
}

<div class="content-area">
    <div class="card shadow-sm border-0" style="max-width: 600px; margin: 0 auto;">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0"><i class="fas fa-user-tag me-2"></i>Editar Rol</h3>
        </div>
        <div class="card-body">
            <form asp-action="Edit" class="needs-validation" novalidate>
                <input type="hidden" asp-for="rol_id" />

                <div class="form-group mb-4">
                    <label asp-for="nombre" class="form-label fw-bold">Nombre del Rol*</label>
                    <input asp-for="nombre" class="form-control form-control-lg" required />
                    <span asp-validation-for="nombre" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <button type="submit" class="btn btn-marron px-4">
                        <i class="fas fa-save me-2"></i>Actualizar
                    </button>
                    <a class="btn btn-outline-marron px-4" asp-controller="RolADO" asp-action="Index">
                        <i class="fas fa-arrow-left me-2"></i>Regresar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}